</style>
<h1>Job <code>__JOB_TEXT__</code> <span id="badge" class="pill">waiting…</span></h1>
<div class="row">
  <div>
    <video id="vid" controls muted playsinline></video>
    <div style="margin-top:8px">
      <button onclick="forcePoll()">Refresh now</button>
